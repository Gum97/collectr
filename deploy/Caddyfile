{
	admin off
}

# Shared by every site block, so a second hostname cannot accidentally be served
# with weaker headers than the first.
(hardened) {
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Behind a tunnel, add `tls internal` to the site block.
#
# A public ACME challenge is answered at Cloudflare, not here, so Caddy cannot
# obtain a certificate and stops serving 443 -- which the tunnel reports as 502.
# The tunnel already provides public TLS; this hop only needs to be encrypted,
# not publicly trusted, and cloudflared is told to accept it.
#
# SITE_ADDRESS must be the hostname visitors actually arrive with.
#
# Caddy matches sites by Host. A request whose Host matches no site here gets an
# empty 200 -- not a 404, not an error, a blank page with a success status. A
# deployment behind a tunnel where SITE_ADDRESS was still the machine's IP served
# blank pages and logged nothing but 200s. If the pages are empty, check this
# first.
#
# Two hostnames, one deployment: put both in SITE_ADDRESS, comma separated --
#   SITE_ADDRESS=form.example.com, rutgon.example.com
# Caddy obtains a certificate for each. The application already knows which is
# which: form pages are built from BASE_URL, short links from the domain each
# link was created on.
#
# To confine the shortener host to redirects -- so the admin API and form pages
# are not reachable there at all -- give it its own block instead:
#
#   rutgon.example.com {
#   	import hardened
#   	@short path /r/* /q/*
#   	handle @short {
#   		reverse_proxy collectr:8080 {
#   			header_up X-Forwarded-Host {host}
#   		}
#   	}
#   	handle {
#   		respond 404
#   	}
#   }
#
# That is the stronger setup: a hostname printed on posters and handed to
# strangers then answers redirects and nothing else.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Second line of defence on body size; the application enforces its own
	# per-endpoint limits. Two layers, because either one can be misconfigured.
	request_body {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		# Referrer headers leak where a visitor came from, which for a form link
		# can itself be personal data.
		Referrer-Policy "no-referrer"
		-Server
	}

	# Public form pages must not load anything from a third party: an external
	# font or script would send visitor data outside the operator's own
	# infrastructure, which is exactly what self-hosting is meant to prevent.
	# /dsr with no trailing slash is the exact URL sent in the magic-link email,
	# and /consent/* is the permalink a consent record points at. Both were
	# outside this matcher and so served without the policy below.
	@public path /f/* /r/* /q/* /dsr /dsr/* /consent/* /p/*
	header @public Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"

	reverse_proxy collectr:8080 {
		header_up X-Forwarded-Host {host}

		# Keep the client address when something else is already in front --
		# a Cloudflare tunnel, nginx, another proxy.
		#
		# Without this Caddy replaces X-Forwarded-For with the address it saw,
		# and the application records the proxy as the visitor. That address is
		# what a consent record cites as evidence of who agreed and from where,
		# and it is what the per-IP rate limit counts, so every visitor arriving
		# through one proxy shares one 60/minute budget.
		#
		# Caddy still appends its own hop, so the header reaching the app looks
		# like "<client>, <caddy>" -- which is why a deployment with anything in
		# front also needs TRUSTED_PROXY_HOPS=2. One without the other is worse
		# than neither: hops=2 with a single-entry header indexes past the end
		# and falls back to the socket peer, silently.
		trusted_proxies private_ranges
	}

	log {
		output stdout
		format json
	}
}
