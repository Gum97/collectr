{
  "_comment": [
    "Shared fixtures for the rule engine. The Go implementation and any client-side",
    "port (WebAssembly build or hand-written) must both pass this file unchanged.",
    "A rule engine that disagrees between browser and server produces forms that",
    "validate on screen and fail on submit, which users experience as the form",
    "simply being broken.",
    "Adding a rule feature means adding a case here in the same commit."
  ],
  "schema": {
    "v": 1,
    "pages": [
      {
        "id": "pg_intro",
        "title": "Contact",
        "fields": [
          "fld_name",
          "fld_used"
        ]
      },
      {
        "id": "pg_detail",
        "title": "Experience",
        "next": "pg_end",
        "fields": [
          "fld_rating",
          "fld_note",
          "fld_tags"
        ]
      },
      {
        "id": "pg_why",
        "title": "Why not",
        "next": "pg_end",
        "fields": [
          "fld_reason"
        ]
      },
      {
        "id": "pg_end",
        "title": "Done",
        "fields": []
      }
    ],
    "fields": {
      "fld_name": {
        "type": "text",
        "label": "Full name",
        "required": true,
        "pii": "name"
      },
      "fld_used": {
        "type": "choice",
        "label": "Have you used the product?",
        "options": [
          {
            "id": "opt_yes",
            "label": "Yes"
          },
          {
            "id": "opt_no",
            "label": "No"
          }
        ]
      },
      "fld_rating": {
        "type": "rating",
        "label": "Rating",
        "scale": 5
      },
      "fld_note": {
        "type": "text",
        "label": "What went wrong?",
        "hidden": true,
        "multiline": true
      },
      "fld_tags": {
        "type": "multi_choice",
        "label": "Which features?",
        "options": [
          {
            "id": "opt_a",
            "label": "A"
          },
          {
            "id": "opt_b",
            "label": "B"
          }
        ]
      },
      "fld_reason": {
        "type": "text",
        "label": "Why not?",
        "required": true
      }
    },
    "rules": [
      {
        "id": "rl_branch",
        "on_page": "pg_intro",
        "when": {
          "op": "eq",
          "field": "fld_used",
          "value": "opt_yes"
        },
        "then": [
          {
            "action": "goto",
            "target": "pg_detail"
          }
        ],
        "else": [
          {
            "action": "goto",
            "target": "pg_why"
          }
        ]
      },
      {
        "id": "rl_lowrating",
        "on_page": "pg_detail",
        "when": {
          "op": "lte",
          "field": "fld_rating",
          "value": 2
        },
        "then": [
          {
            "action": "show",
            "target": "fld_note"
          },
          {
            "action": "require",
            "target": "fld_note"
          }
        ]
      }
    ],
    "consent": {
      "purposes": [
        {
          "code": "service",
          "required": true
        },
        {
          "code": "marketing"
        }
      ]
    }
  },
  "cases": [
    {
      "name": "used the product, happy: detail page without the follow-up",
      "answers": {
        "fld_name": "Nguyen Van A",
        "fld_used": "opt_yes",
        "fld_rating": 5
      },
      "want_path": [
        "pg_intro",
        "pg_detail",
        "pg_end"
      ],
      "want_visible": [
        "fld_name",
        "fld_used",
        "fld_rating",
        "fld_tags"
      ],
      "want_required": [
        "fld_name"
      ]
    },
    {
      "name": "used the product, unhappy: follow-up appears and becomes required",
      "answers": {
        "fld_name": "B",
        "fld_used": "opt_yes",
        "fld_rating": 1
      },
      "want_path": [
        "pg_intro",
        "pg_detail",
        "pg_end"
      ],
      "want_visible": [
        "fld_name",
        "fld_used",
        "fld_rating",
        "fld_note",
        "fld_tags"
      ],
      "want_required": [
        "fld_name",
        "fld_note"
      ]
    },
    {
      "name": "boundary: rating 2 still counts as low",
      "answers": {
        "fld_name": "B",
        "fld_used": "opt_yes",
        "fld_rating": 2
      },
      "want_path": [
        "pg_intro",
        "pg_detail",
        "pg_end"
      ],
      "want_visible": [
        "fld_name",
        "fld_used",
        "fld_rating",
        "fld_note",
        "fld_tags"
      ],
      "want_required": [
        "fld_name",
        "fld_note"
      ]
    },
    {
      "name": "boundary: rating 3 does not",
      "answers": {
        "fld_name": "B",
        "fld_used": "opt_yes",
        "fld_rating": 3
      },
      "want_path": [
        "pg_intro",
        "pg_detail",
        "pg_end"
      ],
      "want_visible": [
        "fld_name",
        "fld_used",
        "fld_rating",
        "fld_tags"
      ],
      "want_required": [
        "fld_name"
      ]
    },
    {
      "name": "did not use the product: the whole detail page is never reached",
      "answers": {
        "fld_name": "C",
        "fld_used": "opt_no",
        "fld_reason": "too expensive"
      },
      "want_path": [
        "pg_intro",
        "pg_why",
        "pg_end"
      ],
      "want_visible": [
        "fld_name",
        "fld_used",
        "fld_reason"
      ],
      "want_required": [
        "fld_name",
        "fld_reason"
      ]
    },
    {
      "name": "unanswered branch field falls through to the else action",
      "answers": {
        "fld_name": "D"
      },
      "want_path": [
        "pg_intro",
        "pg_why",
        "pg_end"
      ],
      "want_visible": [
        "fld_name",
        "fld_used",
        "fld_reason"
      ],
      "want_required": [
        "fld_name",
        "fld_reason"
      ]
    },
    {
      "name": "an unanswered rating does not count as zero, so no follow-up",
      "answers": {
        "fld_name": "E",
        "fld_used": "opt_yes"
      },
      "want_path": [
        "pg_intro",
        "pg_detail",
        "pg_end"
      ],
      "want_visible": [
        "fld_name",
        "fld_used",
        "fld_rating",
        "fld_tags"
      ],
      "want_required": [
        "fld_name"
      ]
    },
    {
      "name": "empty string counts as unanswered",
      "answers": {
        "fld_name": "F",
        "fld_used": "opt_yes",
        "fld_rating": ""
      },
      "want_path": [
        "pg_intro",
        "pg_detail",
        "pg_end"
      ],
      "want_visible": [
        "fld_name",
        "fld_used",
        "fld_rating",
        "fld_tags"
      ],
      "want_required": [
        "fld_name"
      ]
    },
    {
      "name": "answers for fields on a page never visited are simply not visible",
      "answers": {
        "fld_name": "G",
        "fld_used": "opt_no",
        "fld_reason": "no need",
        "fld_rating": 1,
        "fld_note": "injected",
        "fld_tags": [
          "opt_a"
        ]
      },
      "want_path": [
        "pg_intro",
        "pg_why",
        "pg_end"
      ],
      "want_visible": [
        "fld_name",
        "fld_used",
        "fld_reason"
      ],
      "want_required": [
        "fld_name",
        "fld_reason"
      ]
    }
  ],
  "_condition_comment": [
    "Operator-level cases, shared for the same reason as the walk cases above.",
    "These used to live only in the Go test, which meant the client port was never",
    "exercised on in/not_in/contains/between/date ordering or the numeric-string",
    "coercion -- precisely the corners where two implementations drift apart",
    "without anybody noticing until a respondent is routed down the wrong branch."
  ],
  "condition_cases": [
    {
      "name": "eq on option id",
      "cond": {
        "op": "eq",
        "field": "f",
        "value": "opt_a"
      },
      "answers": {
        "f": "opt_a"
      },
      "want": true
    },
    {
      "name": "eq mismatched option",
      "cond": {
        "op": "eq",
        "field": "f",
        "value": "opt_a"
      },
      "answers": {
        "f": "opt_b"
      },
      "want": false
    },
    {
      "name": "eq number as string",
      "cond": {
        "op": "eq",
        "field": "f",
        "value": "3"
      },
      "answers": {
        "f": 3
      },
      "want": true
    },
    {
      "name": "neq",
      "cond": {
        "op": "neq",
        "field": "f",
        "value": "opt_a"
      },
      "answers": {
        "f": "opt_b"
      },
      "want": true
    },
    {
      "name": "in list",
      "cond": {
        "op": "in",
        "field": "f",
        "value": [
          "opt_a",
          "opt_b"
        ]
      },
      "answers": {
        "f": "opt_b"
      },
      "want": true
    },
    {
      "name": "not_in list",
      "cond": {
        "op": "not_in",
        "field": "f",
        "value": [
          "opt_a"
        ]
      },
      "answers": {
        "f": "opt_b"
      },
      "want": true
    },
    {
      "name": "contains on multi-select",
      "cond": {
        "op": "contains",
        "field": "f",
        "value": "opt_b"
      },
      "answers": {
        "f": [
          "opt_a",
          "opt_b"
        ]
      },
      "want": true
    },
    {
      "name": "contains on text",
      "cond": {
        "op": "contains",
        "field": "f",
        "value": "urgent"
      },
      "answers": {
        "f": "this is urgent"
      },
      "want": true
    },
    {
      "name": "gt numeric",
      "cond": {
        "op": "gt",
        "field": "f",
        "value": 3
      },
      "answers": {
        "f": 4
      },
      "want": true
    },
    {
      "name": "lte boundary is inclusive",
      "cond": {
        "op": "lte",
        "field": "f",
        "value": 2
      },
      "answers": {
        "f": 2
      },
      "want": true
    },
    {
      "name": "date ordering compares iso strings",
      "cond": {
        "op": "gte",
        "field": "f",
        "value": "2026-01-01"
      },
      "answers": {
        "f": "2026-08-06"
      },
      "want": true
    },
    {
      "name": "between inclusive",
      "cond": {
        "op": "between",
        "field": "f",
        "value": [
          1,
          5
        ]
      },
      "answers": {
        "f": 5
      },
      "want": true
    },
    {
      "name": "between outside",
      "cond": {
        "op": "between",
        "field": "f",
        "value": [
          1,
          5
        ]
      },
      "answers": {
        "f": 6
      },
      "want": false
    },
    {
      "name": "between needs two bounds",
      "cond": {
        "op": "between",
        "field": "f",
        "value": [
          1
        ]
      },
      "answers": {
        "f": 2
      },
      "want_error": true
    },
    {
      "name": "is_empty on missing",
      "cond": {
        "op": "is_empty",
        "field": "f"
      },
      "answers": {},
      "want": true
    },
    {
      "name": "is_empty on whitespace",
      "cond": {
        "op": "is_empty",
        "field": "f"
      },
      "answers": {
        "f": "   "
      },
      "want": true
    },
    {
      "name": "is_empty on empty list",
      "cond": {
        "op": "is_empty",
        "field": "f"
      },
      "answers": {
        "f": []
      },
      "want": true
    },
    {
      "name": "is_not_empty",
      "cond": {
        "op": "is_not_empty",
        "field": "f"
      },
      "answers": {
        "f": "x"
      },
      "want": true
    },
    {
      "name": "missing answer is not zero",
      "cond": {
        "op": "lte",
        "field": "f",
        "value": 2
      },
      "answers": {},
      "want": false
    },
    {
      "name": "unknown operator",
      "cond": {
        "op": "regex",
        "field": "f",
        "value": ".*"
      },
      "answers": {
        "f": "x"
      },
      "want_error": true
    }
  ]
}