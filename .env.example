# Copy to .env, then run `make secrets` to fill in the generated values.

ENV=prod
# Public origin. QR targets, form links and data-subject portal links are built
# from this, so it must be the address visitors actually reach.
# Origin the shortener serves from. Leave unset to use BASE_URL.
# Set it to run short links on their own hostname:
#   BASE_URL=https://form.example.com
#   SHORT_URL_BASE=https://rutgon.example.com
# Add both to SITE_ADDRESS so Caddy issues a certificate for each.
SHORT_URL_BASE=

BASE_URL=https://links.example.vn
# What Caddy listens on. ":80" for local use; a hostname makes Caddy obtain a
# certificate automatically.
SITE_ADDRESS=:80

# ---------------------------------------------------------------- Secrets
# Generated by `make secrets`. Never commit .env.

# Root key wrapping every per-subject data key.
#
# Back this up SEPARATELY from your database backups. If both are lost together,
# so is every sensitive field and encrypted file -- permanently. That is not a
# defect: it is the property that makes an erasure request actually erase, even
# from backups taken before it.
TENANT_KEK=

# Keys the HMAC over visit tokens. Rotating it invalidates in-flight funnel
# tokens (visitors mid-journey lose attribution) but destroys no stored data.
VISIT_PEPPER=

DB_PASSWORD=
APP_DB_PASSWORD=

# ---------------------------------------------------------------- Storage
# local: files on a mounted volume. Sufficient below roughly 300 GB and while
#        running a single instance.
# s3:    required once you run more than one instance -- local disk is not shared.
# See docs/06-deep-dives.md for the full switch-over thresholds.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/files

# STORAGE_S3_ENDPOINT=http://minio:9000
# STORAGE_S3_BUCKET=collectr
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_USE_SSL=false

# ---------------------------------------------------------------- Email
# Required to invite colleagues and to give data subjects a working access link.
# Leave SMTP_HOST empty and both are written to the log instead -- fine for
# evaluation, useless in production: nobody else can read your logs.
#
# For local testing: `docker compose --profile dev up -d mailpit`, then
# SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_STARTTLS=false, and read the mail at
# http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---------------------------------------------------------------- Compliance
# Deliberately configuration, not constants: these numbers follow legal advice,
# and legal advice changes.

# Deadline for answering a data subject's request.
DSR_SLA_HOURS=72
# Default retention for submissions when a form sets none.
DEFAULT_RETENTION_DAYS=730
# Raw analytics events. Rollups are kept indefinitely and are much smaller.
RAW_EVENT_RETENTION_DAYS=90

# controller: you run Collectr for your own organisation.
# processor:  you run it as a service for others. Restricts operator access to
#             plaintext and audits administrative reads.
DEPLOYMENT_ROLE=controller

# ---------------------------------------------------------------- Tuning
# LINK_CACHE_TTL_SECONDS=300
# LINK_NEGATIVE_CACHE_TTL_SECONDS=30
# VISIT_TOKEN_TTL_MINUTES=30
# EVENT_STREAM_MAXLEN=1000000
# EVENT_BUFFER_SIZE=10000
METRICS_TOKEN=

# Guards the one-time endpoint that creates the first owner account. Leave it
# unset and the server generates one on first boot and writes it to the log,
# where the operator who just started the container is already looking:
#   docker compose logs collectr | grep setup_token
# There is deliberately no default account. Default credentials on a
# self-hosted product survive in production for years.
SETUP_TOKEN=

# Submissions and uploads per minute on the public endpoints, by caller /24 and
# by form. The defaults suit a form on a website; a conference stand behind one
# NAT needs the IP limit raised. Both fail open when Redis is down: refusing a
# customer's response loses it for good, and the outage is already paging
# somebody.
PUBLIC_WRITE_IP_LIMIT=60
PUBLIC_WRITE_FORM_LIMIT=600

# How many reverse proxies sit in front of this process.
#
# The application reads the client address from that many hops back in
# X-Forwarded-For. Getting it wrong is silent: the address ends up in the
# per-IP rate limit and in the consent record that says who agreed and from
# where, and nothing errors.
#
#   1  the shipped stack: Caddy only                       (default)
#   2  something in front of Caddy: Cloudflare, nginx, a tunnel
#   1  a tunnel or nginx straight to the app, with Caddy removed
#   0  the binary exposed directly -- X-Forwarded-For is then ignored entirely
#
# Check it rather than reason about it: open the organisation settings screen
# and compare the address it shows against your own.
TRUSTED_PROXY_HOPS=1
